generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String         @id @default(uuid()) @db.Uuid
    name         String         @db.VarChar(100)
    email        String
    pictureUrl   String?        @map("picture_url") @db.VarChar(255)
    provider     String
    providerId   String         @map("provider_id")
    role         String         @default("USER")
    createdAt    DateTime       @default(now()) @map("created_at")
    updatedAt    DateTime?      @updatedAt @map("updated_at")
    lastLogin    DateTime?      @map("last_login")
    refreshToken RefreshToken?
    posts        Post[]
    likes        PostLike[]
    bookmarks    PostBookmark[]
    mediaAssets  MediaAsset[]
    newsletters  Newsletter[]
    documents    Document[]

    @@unique([email, providerId])
    @@map("users")
}

model Tag {
    id        String   @id @default(uuid()) @db.Uuid
    label     String   @db.VarChar(80)
    category  String   @db.VarChar(20)
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([category, label])
    @@index([category])
    @@map("tags")
}

model SystemSetting {
    id                   Int     @id @default(1)
    collaborationEnabled Boolean @default(false) @map("collaboration_enabled")
    documentAutosaveEnabled Boolean @default(true) @map("document_autosave_enabled")
    documentAutosaveDelay   Int     @default(700) @map("document_autosave_delay")

    @@map("system_settings")
}

model RefreshToken {
    id           Int      @id @default(autoincrement())
    userId       String   @unique @map("user_id") @db.Uuid
    refreshToken String   @unique @map("refresh_token")
    expiry       DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("refresh_tokens")
}

model Post {
    id        String       @id @default(uuid()) @db.Uuid
    title     String       @db.VarChar(200)
    description String?    @db.Text
    content   String       @db.Text
    visibility String       @default("PUBLIC") @db.VarChar(12)
    authorId  String       @map("author_id") @db.Uuid
    mediaId   String?      @map("media_id") @db.Uuid
    createdAt DateTime     @default(now()) @map("created_at")
    updatedAt DateTime     @updatedAt @map("updated_at")
    author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
    media     MediaAsset?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
    likes     PostLike[]
    bookmarks PostBookmark[]

    @@index([createdAt])
    @@index([authorId])
    @@index([visibility, createdAt])
    @@map("posts")
}

model PostLike {
    postId    String   @map("post_id") @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")
    post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([postId, userId])
    @@index([userId])
    @@map("post_likes")
}

model PostBookmark {
    postId    String   @map("post_id") @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")
    post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([postId, userId])
    @@index([userId])
    @@map("post_bookmarks")
}

model Newsletter {
    id          String    @id @default(uuid()) @db.Uuid
    title       String    @db.VarChar(200)
    subject     String    @db.VarChar(200)
    content     String    @db.Text
    status      String    @default("DRAFT") @db.VarChar(20)
    authorId    String    @map("author_id") @db.Uuid
    publishedAt DateTime? @map("published_at")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")
    author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

    @@index([status, publishedAt])
    @@index([authorId])
    @@map("newsletters")
}

model MediaAsset {
    id        String   @id @default(uuid()) @db.Uuid
    data      Bytes    @db.ByteA
    mimeType  String   @map("mime_type") @db.VarChar(255)
    filename  String?  @db.VarChar(255)
    ownerId   String   @map("owner_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")
    owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    posts     Post[]
    platformCover ReadingPlatform?
    documents Document[]

    @@index([ownerId])
    @@map("media_assets")
}

model ReadingPlatform {
    id             String     @id @default(uuid()) @db.Uuid
    slug           String     @unique @db.VarChar(50)
    name           String     @db.VarChar(100)
    websiteUrl     String     @map("website_url") @db.Text
    coverSourceUrl String     @map("cover_source_url") @db.Text
    description    String?    @db.Text
    coverMediaId   String     @unique @map("cover_media_id") @db.Uuid
    createdAt      DateTime   @default(now()) @map("created_at")
    updatedAt      DateTime   @updatedAt @map("updated_at")
    coverMedia     MediaAsset @relation(fields: [coverMediaId], references: [id], onDelete: Restrict)

    @@map("reading_platforms")
}

model Document {
    id        String      @id @default(uuid()) @db.Uuid
    title     String      @db.VarChar(200)
    content   String      @db.Text
    visibility String     @default("PUBLIC") @db.VarChar(12)
    authorId  String      @map("author_id") @db.Uuid
    mediaId   String?     @map("media_id") @db.Uuid
    createdAt DateTime    @default(now()) @map("created_at")
    updatedAt DateTime    @updatedAt @map("updated_at")
    author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
    media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
    pages     DocumentPage[]

    @@index([authorId])
    @@index([createdAt])
    @@index([visibility, createdAt])
    @@map("documents")
}

model DocumentPage {
    id         String   @id @default(uuid()) @db.Uuid
    documentId String   @map("document_id") @db.Uuid
    parentId   String?  @map("parent_id") @db.Uuid
    title      String   @db.VarChar(200)
    content    String   @db.Text
    position   Int
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
    parent     DocumentPage? @relation("DocumentPageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children   DocumentPage[] @relation("DocumentPageHierarchy")

    @@unique([documentId, position])
    @@index([documentId])
    @@index([parentId])
    @@map("document_pages")
}
